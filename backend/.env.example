# SOC Application Environment Configuration
PROJECT_NAME="SHIELD SOC Threat Intelligence Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security / JWT
SECRET_KEY="replace-this-with-a-very-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default is PostgreSQL. If PostgreSQL is unreachable or unset, system safely falls back to local SQLite dev db
DATABASE_URL="postgresql://shield_user:shield_password@localhost:5432/shield_db"

# Cybersecurity Threat Intel Integrations
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""

# Incident Alerting Services
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_TO_NUMBER=""

SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
ADMIN_EMAIL=""
