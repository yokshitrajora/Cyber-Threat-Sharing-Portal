# ==============================================================================
# Shield AI Threat Intelligence Platform — Production Environment Variables
# ==============================================================================

# Application Metadata & Runtime Mode
PROJECT_NAME="Shield AI Threat Intelligence SOC Core"
ENVIRONMENT="production"
VERSION="5.0.0"
PORT=8000
WORKERS=4

# JWT Authentication Security (Generate with: openssl rand -hex 32)
SECRET_KEY="generate-a-secure-random-secret-key-for-production-deployment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 16 Recommended for Production)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://shield_user:shield_password_prod_secure@db:5432/shield_db"

# Docker Database Credentials
POSTGRES_USER="shield_user"
POSTGRES_PASSWORD="shield_password_prod_secure"
POSTGRES_DB="shield_db"

# Background Worker Queue (Celery + Redis)
REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/0"

# CORS Allowed Origins (Comma-separated for multiple domains)
CORS_ORIGINS="https://yourdomain.com,https://api.yourdomain.com,http://localhost"

# External Cyber-Threat Intelligence APIs
# VirusTotal API v3 (https://www.virustotal.com/gui/user/apiKey)
VIRUSTOTAL_API_KEY=""

# AbuseIPDB API v2 (https://www.abuseipdb.com/account/api)
ABUSEIPDB_API_KEY=""

# Automated Weekly Email Digest & Security Alerts (SendGrid)
# https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=""
ALERT_EMAIL_FROM="security@shieldcommunity.io"
ALERT_EMAIL_TO="soc-alerts@shieldcommunity.io"

# Critical SMS Broadcasts (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+1234567890"
ALERT_PHONE_NUMBER="+1234567890"
